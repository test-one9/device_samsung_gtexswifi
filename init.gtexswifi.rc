on boot
    # Permissions for Bluetooth
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth net_bt_admin /sys/class/rfkill/rfkill0/state

    # Permissions for Sensors
    chown system system /sys/class/sensors/accelerometer_sensor/raw_data
    chown system system /sys/class/sensors/accelerometer_sensor/calibration

    # Spreadtrum graphics and framebuffers
    chmod 0666 /dev/mali0
    chown system graphics /dev/mali0
    chmod 0660 /dev/ion
    chown system graphics /dev/ion

    # Set up Wifi interface permissions
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/system 0775 system system

# WPA Supplicant Service
service wpa_supplicant /vendor/bin/hw/wpa_supplicant \
    -iglink0 -g@android:wpa_wlan0 \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -e/data/misc/wifi/entropy.bin \
    -g@android:wpa_wlan0 \
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# Sensor Hub control daemon (SC7730SW specific)
service sensor_hubd /vendor/bin/sensor_hubd
    class main
    user system
    group system
    oneshot
