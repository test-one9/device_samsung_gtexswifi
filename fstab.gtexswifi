# Android fstab for gtexswifi (Samsung Galaxy Tab A 7.0 2016 SM-T280)
# <src>                                                <mnt>       <type>  <mnt_flags and options>                             <fs_mgr_flags>

/dev/block/platform/soc/21900000.sdio/by-name/system    /system     ext4    ro,barrier=1,noatime                                 wait
/dev/block/platform/soc/21900000.sdio/by-name/userdata  /data       ext4    noatime,nosuid,nodev,barrier=1,noauto_da_alloc,errors=panic wait,check,encryptable=footer
/dev/block/platform/soc/21900000.sdio/by-name/cache     /cache      ext4    noatime,nosuid,nodev,barrier=1,errors=panic          wait,check
/dev/block/platform/soc/21900000.sdio/by-name/boot      /boot       emmc    defaults                                            defaults
/dev/block/platform/soc/21900000.sdio/by-name/recovery  /recovery   emmc    defaults                                            defaults
/dev/block/platform/soc/21900000.sdio/by-name/efs       /efs        ext4    noatime,nosuid,nodev,barrier=1                      wait,check

# SD Card & Storage definitions
# Default Storage arrangement (Internal primary)
/devices/platform/soc/21910000.sdio/mmc_host*           auto        auto    defaults                                            wait,voldmanaged=sdcard1:auto
/devices/platform/soc/21920000.sdio/mmc_host*           auto        auto    defaults                                            wait,voldmanaged=sdcard0:auto

# zRAM configuration (Dynamically adjusted in build settings)
/dev/block/zram0                                         none        swap    defaults                                            zramsize=1073741824
