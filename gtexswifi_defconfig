#
# Linux Kernel 3.10.108 Configuration for Samsung Galaxy Tab A 7.0 (2016)
# Target Architecture: ARMv7 (gtexswifi)
#

CONFIG_ARM=y
CONFIG_SYS_SUPPORT_APCS=y
CONFIG_ARCH_SC8830=y
CONFIG_MACH_GTEXSWIFI=y

# Kernel clock and frequency scaling
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y

# Android Essential Drivers for LineageOS 15.1 (Android 8.1 Oreo)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y
CONFIG_STAGING=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y

# File Systems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_VFAT_FS=y

# Networking & TCP Congestion Algorithm
CONFIG_NET=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_DEFAULT_TCP_CONG="westwood"

# Graphics and Mali Support
CONFIG_MALI400=y
CONFIG_MALI400_DEBUG=y
CONFIG_ION=y
CONFIG_ION_SC8830=y

# USB and Power management
CONFIG_USB_GADGET=y
CONFIG_USB_ANDROID_MTP=y
CONFIG_POWER_SUPPLY=y
CONFIG_SAMSUNG_BATTERY=y
